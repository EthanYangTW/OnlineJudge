# Copy this file to .env beside compose.yaml. Never commit .env.
FCU_DB_PASSWORD=REPLACE_WITH_RANDOM_VALUE
FCU_JUDGE_TOKEN=REPLACE_WITH_INDEPENDENT_RANDOM_VALUE
FCU_TEACHER_USER=teacher
FCU_TEACHER_PASSWORD=REPLACE_WITH_LONG_RANDOM_VALUE
FCU_BIND=127.0.0.1
FCU_HTTP_PORT=5482
# Only addresses of the actual reverse proxy are trusted to set X-Real-IP.
FCU_TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1
